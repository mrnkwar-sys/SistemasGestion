@model List<Ejercicio02.Models.Entities.clsPersona>

@{
    ViewData["Title"] = "Listado de Personas";
}

<div class="text-center">
    <h1>@ViewData["Title"]</h1>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellidos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var persona in @Model)
            {
                <tr>
                    <td>@persona.Id</td>
                    <td>@persona.Nombre</td>
                    <td>@persona.Apellidos</td>
                </tr>
            }
        </tbody>
    </table>
</div>
